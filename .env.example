# ---- required for docker compose ----
DOMAIN=chat.example.com          # your domain (DNS A record -> this server)
PUBLIC_IP=203.0.113.10           # this server's public IPv4 (for the TURN relay)
IP_SALT=change-me-to-a-long-random-string     # openssl rand -hex 32
TURN_SECRET=change-me-to-another-long-random  # openssl rand -hex 32

# ---- optional ----
BAN_HOURS=72

# ---- running the Node server WITHOUT docker (see README) ----
# NODE_ENV=production
# PORT=3000
# CLIENT_IP_HEADER=cf-connecting-ip      # Render / Cloudflare Tunnel (auto-set on Render)
# TRUST_PROXY_HOPS=1                      # 1 if behind nginx/Caddy/Cloudflare tunnel, else 0
# ALLOWED_ORIGINS=https://chat.example.com
# DATA_DIR=./data
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:chat.example.com:3478?transport=udp
# TURN_SECRET=...
# BAN_SCORE=3                              # weighted unique reports (nudity/minor=2, others=1) in 24h
# MAX_CONN_PER_IP=20
# PUBLIC_URL=https://chat.example.com    # optional: forces the address used in share previews
# CSP=off                                 # only to debug a blank page; leave unset for security

# ---- "Buy me a coffee" gifts (all optional; the button only offers what you configure) ----
# Card / e-DINAR / wallet via Konnect (card details are typed on Konnect's own page, never on your server).
# Create a Konnect account, then copy these from the dashboard. Starts in TEST mode until you set KONNECT_SANDBOX=false.
# KONNECT_API_KEY=your_wallet_id:your_api_secret
# KONNECT_WALLET_ID=your_wallet_id          # optional, defaults to the part before ':' in the key
# KONNECT_SANDBOX=false                     # set to false for real money
# Postal transfer details shown to visitors who prefer to send from their own CCP / bank / mobile wallet:
# DONATE_NAME=Your Name
# DONATE_CCP=...
DONATE_RIB=10016131101497378895   # STB
# DONATE_PHONE=...

# Private visitor dashboard: open  /stats?key=<STATS_KEY>  (use a long random secret)
STATS_KEY=
